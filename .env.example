# Server
PORT=3004
NODE_ENV=development

# Database
DATABASE_URL="mysql://carpooling_notifications_user:carpooling_notifications_password@localhost:3307/carpooling_notifications"

# SMTP Configuration (Zoho)
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=YouConnext
SMTP_FROM_EMAIL=noreply@youconnext.es

# Admin email for notifications
ADMIN_EMAIL=admin@example.com

# Admin suggestions review URL (append /{suggestionId})
ADMIN_SUGGESTIONS_URL=http://localhost:3000/admin/suggestions

# Frontend URL (for email templates links)
FRONTEND_URL=http://localhost:3000

# JWT Verification
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"

# Firebase / FCM Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# RabbitMQ
RABBITMQ_URL=amqp://carpooling:carpooling123@localhost:5672
