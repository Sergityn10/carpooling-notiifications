# Server
PORT=3004
NODE_ENV=development
RUN_WORKERS=true

# Database (ajustar connection_limit segun numero de workers en VPS)
DATABASE_URL="mysql://carpooling_notifications_user:carpooling_notifications_password@localhost:3307/carpooling_notifications?connection_limit=5"

# SMTP Configuration (Zoho)
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=YouConnext
SMTP_FROM_EMAIL=noreply@youconnext.es
SMTP_MAX_CONNECTIONS=3

# Internal Service-to-Service Auth & User Directory (ms-usuarios)
INTERNAL_SERVICE_API_KEY=change-me-shared-internal-key
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_BATCH_PATH=/api/users/internal/batch
USER_SERVICE_LIST_PATH=/api/users/internal/list
USER_SERVICE_TIMEOUT_MS=5000
ALLOW_DEVICE_EMAIL_FALLBACK=false

# Admin Notifications Tuning
ADMIN_MAX_SYNC_RECIPIENTS=50
ADMIN_STATUS_CHECK_TIMEOUT_MS=4000
ADMIN_HISTORY_MAX_ENTRIES=100

# Admin email for notifications
ADMIN_EMAIL=admin@example.com

# Admin suggestions review URL (append /{suggestionId})
ADMIN_SUGGESTIONS_URL=http://localhost:3000/admin/suggestions

# Frontend URL (for email templates links)
FRONTEND_URL=http://localhost:3000

# JWT Verification
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"

# Firebase / FCM Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# RabbitMQ & Batch Tuning (VPS)
RABBITMQ_URL=amqp://carpooling:carpooling123@localhost:5672
RABBITMQ_PREFETCH=20
MAX_BATCH_RECIPIENTS=5000
EMAIL_LOOKUP_CHUNK_SIZE=200
PUSH_BATCH_CHUNK_SIZE=500
MAX_CONCURRENT_PUSH=5
MAX_CONCURRENT_EMAIL=3
